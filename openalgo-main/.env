# Database (connects to betting-db container on Docker network)
DATABASE_URL=postgresql://betting_user:betting_password@betting-db:5432/betting_markets

# Dashboard URLs
PUBLIC_URL=https://algo.bhakta.us
DASHBOARD_URL=https://algo.bhakta.us/dashboard
API_URL=https://algo.bhakta.us/api
WS_URL=wss://algo.bhakta.us/ws

# Kalshi API V2 (use demo environment for paper trading)
KALSHI_API_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_ENVIRONMENT=demo

# Security
CORS_ENABLED=true
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true

# OpenAlgo Dashboard
ENABLE_TAILSCALE=true
USE_DASHBOARD_KEYS=true

# Super Bowl Paper Trading
SUPER_BOWL_ANALYZE_MODE=paper
SUPER_BOWL_PAPER_BANKROLL=1000
SUPER_BOWL_RISK_LEVEL=moderate
TZ=America/Chicago
LOG_LEVEL=INFO
