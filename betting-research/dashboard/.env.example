# Dashboard Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=betting_markets
DB_USER=betting_user
DB_PASSWORD=betting_password

# Dashboard API Configuration (Optional)
# Set these if you're using Openalgo Dashboard for key management
DASHBOARD_API_URL=http://localhost:5000
DASHBOARD_USERNAME=your_username
DASHBOARD_PASSWORD=your_password

# Security Configuration
# Generate a secure 32-byte key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8888
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Kalshi API Configuration (for the bot)
KALSHI_API_KEY=your_kalshi_api_key
KALSHI_API_SECRET=your_kalshi_api_secret
KALSHI_ENVIRONMENT=demo

# PostgreSQL Password (for docker-compose)
POSTGRES_PASSWORD=betting_password
